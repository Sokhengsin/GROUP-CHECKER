PORT=3000

# OPTIONAL. Leave empty for basic membership checks (works for any public community).
# If set, the server also tries Roblox Open Cloud to read the membership join time for
# communities this key has access to. Keep it secret: never put it in public/index.html.
ROBLOX_API_KEY=

# Membership-age wait periods (days). Configurable because Roblox rules can change.
STANDARD_PAYOUT_WAIT_DAYS=14
VERIFIED_GROUP_PAYOUT_WAIT_DAYS=3
